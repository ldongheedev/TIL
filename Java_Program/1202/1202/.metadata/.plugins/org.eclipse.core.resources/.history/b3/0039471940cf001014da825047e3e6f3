package sec01;

import javax.swing.*;
import java.awt.*;
import java.io.*;
import java.util.*;

public class StudentViewer extends JFrame {
    ArrayList<Student> list = new ArrayList<>();
    int index;

    JLabel lblPhoto;
    JLabel lblId, lblName, lblMid, lblFin, lblTotal, lblAvg;

    JButton btnFirst, btnPrev, btnNext, btnLast;

    public StudentViewer() {
        setLayout(new BorderLayout());

        lblPhoto = new JLabel("", SwingConstants.CENTER);
        add(lblPhoto, BorderLayout.NORTH);

        JPanel infoPanel = new JPanel(new GridLayout(6, 1));
        lblId = new JLabel("", SwingConstants.CENTER);
        lblName = new JLabel("", SwingConstants.CENTER);
        lblMid = new JLabel("", SwingConstants.CENTER);
        lblFin = new JLabel("", SwingConstants.CENTER);
        lblTotal = new JLabel("", SwingConstants.CENTER);
        lblAvg = new JLabel("", SwingConstants.CENTER);

        infoPanel.add(lblId);
        infoPanel.add(lblName);
        infoPanel.add(lblMid);
        infoPanel.add(lblFin);
        infoPanel.add(lblTotal);
        infoPanel.add(lblAvg);

        add(infoPanel, BorderLayout.CENTER);
        Font f = new Font("맑은 고딕", Font.BOLD, 20);
        setPanelFont(infoPanel, f);

        JPanel panel = new JPanel();
        btnFirst = new JButton("처음");
        btnPrev = new JButton("이전");
        btnNext = new JButton("다음");
        btnLast = new JButton("마지막");
        panel.add(btnFirst);
        panel.add(btnPrev);
        panel.add(btnNext);
        panel.add(btnLast);
        add(panel, BorderLayout.SOUTH);
        setPanelFont(panel, f);

        loadFile("students.csv");
        index = 0;
        if (!list.isEmpty()) {
            displayStudent(index);
        } else {
            setTitle("학생 데이터가 없습니다");
        }

        btnFirst.addActionListener(e -> {
            index = 0;
            displayStudent(index);
        });

        btnPrev.addActionListener(e -> {
            if (index == 0) message("첫 번째 학생입니다.");
            else { index--; displayStudent(index); }
        });

        btnNext.addActionListener(e -> {
            if (index == list.size() - 1) message("마지막 학생입니다.");
            else { index++; displayStudent(index); }
        });

        btnLast.addActionListener(e -> {
            index = list.size() - 1;
            displayStudent(index);
        });

        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(400, 500);
        setVisible(true);
    }

    void message(String text) {
        JOptionPane.showMessageDialog(this, text);
    }

    void setPanelFont(JPanel panel, Font font) {
        for (Component comp : panel.getComponents()) comp.setFont(font);
    }

    void loadFile(String filename) {
        try (BufferedReader br = new BufferedReader(new FileReader(filename))) {
            String line = br.readLine(); // 헤더 건너뛰기
            while ((line = br.readLine()) != null) {
                String[] arr = line.split(",");
                list.add(new Student(
                    arr[2],           // photo
                    arr[0],           // id
                    arr[1],           // name
                    Integer.parseInt(arr[3]), // mid
                    Integer.parseInt(arr[4])  // fin
                ));
            }
        } catch (Exception e) {
            e.printStackTrace();
            message("파일을 읽는 중 오류가 발생했습니다: " + e.getMessage());
        }
    }

    void displayStudent(int idx) {
        if (idx < 0 || idx >= list.size()) return;
        Student s = list.get(idx);

        String path = "images/" + s.photo + ".png";
        File img = new File(path);
        lblPhoto.setIcon(img.exists() ? new ImageIcon(path) : null);
        lblPhoto.setText(img.exists() ? "" : "사진 없음: " + path);

        setTitle(s.name + " 학생 정보 보기");

        lblId.setText("학번: " + s.id);
        lblName.setText("이름: " + s.name);
        lblMid.setText("중간고사: " + s.mid);
        lblFin.setText("기말고사: " + s.fin);
        lblTotal.setText("합계: " + s.getTotal());
        lblAvg.setText("평균: " + String.format("%.2f", s.getAverage()));
    }
}

public class StudentViewerTest {
    public static void main(String[] args) {
        new StudentViewer();
    }
}

