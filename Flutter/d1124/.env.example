# Environment variables template for d1124 project
# Copy this file to .env and fill in the actual values

# Google Maps API Key (if needed)
# GOOGLE_MAPS_API_KEY=

# Firebase Configuration (if needed)
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_DATABASE_URL=

# Other API endpoints and credentials
# API_BASE_URL=
# API_KEY=
# AUTH_TOKEN=
